DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# MySQL. Leave DB_NAME empty to use a local SQLite file instead.
DB_NAME=scholarfinder
DB_USER=scholarfinder
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# GROBID PDF extraction
GROBID_URL=http://localhost:8070
GROBID_TIMEOUT=180
GROBID_MAX_WORKERS=4
# Correct header metadata against CrossRef (needs internet access)
GROBID_CONSOLIDATE_HEADER=True
GROBID_CONSOLIDATE_CITATIONS=False

# Optional: host uploaded PDFs on Google Drive instead of the local media folder
GOOGLE_DRIVE_CLIENT_SECRET_FILE=
GOOGLE_DRIVE_TOKEN_FILE=token_drive_v3.pickle
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
